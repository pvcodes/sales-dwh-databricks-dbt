# Template for the Databricks connection profile.
#
# Copy to ~/.dbt/profiles.yml and fill in the workspace details, or export the
# matching environment variables and remove the hard-coded values:
#
#   cp dbt/profiles/profiles_databricks.yml.example ~/.dbt/profiles.yml
#
# The Databricks CLI and Asset Bundles use the same host/token pair, so dbt and
# the ingestion jobs always talk to the same workspace.

sales_dwh:
  target: dev
  outputs:
    dev:
      type: databricks
      catalog: "{{ env_var('DATABRICKS_CATALOG', 'sales_dwh_dev') }}"
      schema: bronze
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      threads: 8
      connect_timeout: 60
      retry_all: true

    prod:
      type: databricks
      catalog: "{{ env_var('DATABRICKS_PROD_CATALOG', 'sales_dwh') }}"
      schema: bronze
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_PROD_HTTP_PATH') }}"
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      threads: 16
      connect_timeout: 60
      retry_all: true
